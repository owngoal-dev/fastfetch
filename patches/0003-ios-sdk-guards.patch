diff --git a/src/common/apple/osascript.m b/src/common/apple/osascript.m
index f17af03..28165b7 100644
--- a/src/common/apple/osascript.m
+++ b/src/common/apple/osascript.m
@@ -4,6 +4,11 @@
 
 bool ffOsascript(const char* input, FFstrbuf* result)
 {
+#if TARGET_OS_IPHONE
+    // No AppleScript on iOS
+    (void) input; (void) result;
+    return false;
+#else
     NSAppleScript* script = [NSAppleScript.alloc initWithSource:@(input)];
     NSDictionary* errInfo = nil;
     NSAppleEventDescriptor* descriptor = [script executeAndReturnError:&errInfo];
@@ -12,4 +17,5 @@ bool ffOsascript(const char* input, FFstrbuf* result)
 
     ffStrbufSetS(result, descriptor.stringValue.UTF8String);
     return true;
+#endif
 }

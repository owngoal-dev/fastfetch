diff --git a/src/detection/os/os_ios.m b/src/detection/os/os_ios.m
new file mode 100644
index 0000000..f90d3c1
--- /dev/null
+++ b/src/detection/os/os_ios.m
@@ -0,0 +1,32 @@
+#include "os.h"
+#include "common/sysctl.h"
+
+#import <Foundation/Foundation.h>
+
+void ffDetectOSImpl(FFOSResult* os)
+{
+    // SystemVersion.plist says "iPhone OS" for every device; tell iPad apart by
+    // the hardware identifier so the name matches what Apple calls it.
+    FF_STRBUF_AUTO_DESTROY machine = ffStrbufCreate();
+    ffSysctlGetString("hw.machine", &machine);
+    bool iPad = ffStrbufStartsWithS(&machine, "iPad");
+    ffStrbufSetStatic(&os->name, iPad ? "iPadOS" : "iOS");
+    ffStrbufSetStatic(&os->id, iPad ? "ipados" : "ios");
+    ffStrbufSetStatic(&os->idLike, "macos"); // picks the Apple logo
+
+    NSDictionary* dict = [NSDictionary dictionaryWithContentsOfURL:[NSURL fileURLWithPath:@"/System/Library/CoreServices/SystemVersion.plist" isDirectory:NO]
+                                                             error:nil];
+    NSString* value;
+    if ((value = dict[@"ProductVersion"]))
+        ffStrbufSetS(&os->version, value.UTF8String);
+    if ((value = dict[@"ProductBuildVersion"]))
+        ffStrbufSetS(&os->buildID, value.UTF8String);
+
+    if (os->version.length == 0)
+        ffSysctlGetString("kern.osproductversion", &os->version);
+    if (os->buildID.length == 0)
+        ffSysctlGetString("kern.osversion", &os->buildID);
+
+    ffStrbufSet(&os->versionID, &os->version);
+    ffStrbufSetF(&os->prettyName, "%s %s (%s)", os->name.chars, os->version.chars, os->buildID.chars);
+}
diff --git a/src/detection/packages/packages_ios.c b/src/detection/packages/packages_ios.c
new file mode 100644
index 0000000..b194853
--- /dev/null
+++ b/src/detection/packages/packages_ios.c
@@ -0,0 +1,42 @@
+#include "packages.h"
+#include "common/io.h"
+
+#include <string.h>
+
+static uint32_t countDpkgStatus(const char* path) {
+    FF_STRBUF_AUTO_DESTROY content = ffStrbufCreate();
+    if (!ffReadFileBuffer(path, &content)) {
+        return 0;
+    }
+
+    const char needle[] = "Status: install ok installed";
+    uint32_t count = 0;
+    for (const char* iter = content.chars; (iter = strstr(iter, needle)) != nullptr; iter += sizeof(needle) - 1) {
+        ++count;
+    }
+    return count;
+}
+
+void ffDetectPackagesImpl(FFPackagesResult* result, FFPackagesOptions* options) {
+    if (!FF_PACKAGES_IS_ENABLED(options, DPKG)) {
+        return;
+    }
+
+    // dpkg lives inside the bootstrap: /var/jb on rootless, a randomized jbroot
+    // on RootHide, / on rootful. This binary is installed at <bootstrap>/usr/bin,
+    // so derive the bootstrap from the executable path; the fixed candidates are
+    // for running a build that is not installed.
+    FF_STRBUF_AUTO_DESTROY path = ffStrbufCreateCopy(&instance.state.platform.exePath);
+    ffStrbufSubstrBeforeLastC(&path, '/');
+    ffStrbufSubstrBeforeLastC(&path, '/');
+    ffStrbufSubstrBeforeLastC(&path, '/');
+    ffStrbufAppendS(&path, "/var/lib/dpkg/status");
+
+    const char* candidates[] = { path.chars, "/var/jb/var/lib/dpkg/status", "/var/lib/dpkg/status" };
+    for (uint32_t i = 0; i < ARRAY_SIZE(candidates); ++i) {
+        result->dpkg = countDpkgStatus(candidates[i]);
+        if (result->dpkg > 0) {
+            break;
+        }
+    }
+}

diff --git a/src/detection/displayserver/displayserver_ios.c b/src/detection/displayserver/displayserver_ios.c
new file mode 100644
index 0000000..96a1937
--- /dev/null
+++ b/src/detection/displayserver/displayserver_ios.c
@@ -0,0 +1,64 @@
+#include "displayserver.h"
+#include "common/library.h"
+
+#include <CoreFoundation/CoreFoundation.h>
+
+// Private, dlopen'd; only the prototype is needed for the symbol macros.
+CFTypeRef MGCopyAnswer(CFStringRef property);
+
+// iOS has no CoreGraphics display list. The built-in panel is described by
+// MobileGestalt, which is in the shared cache on every device; the main-screen
+// keys are not entitlement-protected.
+static bool mgGetDouble(CFTypeRef (*ffMGCopyAnswer)(CFStringRef), CFStringRef key, double* result) {
+    CFTypeRef value = ffMGCopyAnswer(key);
+    if (!value) {
+        return false;
+    }
+    bool ok = CFGetTypeID(value) == CFNumberGetTypeID() && CFNumberGetValue((CFNumberRef) value, kCFNumberDoubleType, result);
+    CFRelease(value);
+    return ok;
+}
+
+static const char* detectDisplay(FFDisplayServerResult* ds) {
+    FF_LIBRARY_LOAD(mg, "dlopen libMobileGestalt failed", "/usr/lib/libMobileGestalt.dylib", -1);
+    FF_LIBRARY_LOAD_SYMBOL_MESSAGE(mg, MGCopyAnswer);
+
+    double width = 0, height = 0, scale = 1, pitch = 0;
+    if (!mgGetDouble(ffMGCopyAnswer, CFSTR("main-screen-width"), &width) ||
+        !mgGetDouble(ffMGCopyAnswer, CFSTR("main-screen-height"), &height)) {
+        return "MGCopyAnswer(main-screen-*) failed";
+    }
+    mgGetDouble(ffMGCopyAnswer, CFSTR("main-screen-scale"), &scale);
+    mgGetDouble(ffMGCopyAnswer, CFSTR("main-screen-pitch"), &pitch); // pixels per inch
+
+    uint32_t physicalWidth = 0, physicalHeight = 0;
+    if (pitch > 0) {
+        physicalWidth = (uint32_t) (width * 25.4 / pitch + 0.5);
+        physicalHeight = (uint32_t) (height * 25.4 / pitch + 0.5);
+    }
+
+    FF_STRBUF_AUTO_DESTROY name = ffStrbufCreate();
+    ffdsAppendDisplay(ds,
+        (uint32_t) width,
+        (uint32_t) height,
+        0, // ponytail: refresh rate needs UIScreen/IOMobileFramebuffer; add if anyone asks
+        (uint32_t) (96 * scale),
+        (uint32_t) width,
+        (uint32_t) height,
+        0,
+        0,
+        &name,
+        FF_DISPLAY_TYPE_BUILTIN,
+        true,
+        0,
+        physicalWidth,
+        physicalHeight,
+        "MobileGestalt");
+    return nullptr;
+}
+
+void ffConnectDisplayServerImpl(FFDisplayServerResult* ds) {
+    ffStrbufSetStatic(&ds->wmProcessName, "SpringBoard");
+    ffStrbufSetStatic(&ds->wmPrettyName, "SpringBoard");
+    detectDisplay(ds);
+}
